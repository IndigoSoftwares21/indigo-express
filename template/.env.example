DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=indigo_db
DB_PORT=5432
# Set to "true" for hosted Postgres providers that require SSL. Local
# Postgres (including this template's docker-compose service) doesn't
# support it — leave this false for local development.
DB_SSL=false
NODE_ENV=development
PORT=6969
API_VERSION=v1
# Column casing for generated Kysely types (src/database/types.ts): "camel" or "snake".
# Table names are unaffected either way.
DB_TYPES_CASE=camel
